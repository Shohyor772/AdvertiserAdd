# Copy to .env locally. Never commit .env or send secrets in chat.
DEBUG=true
EDUCATIONAL_MODE=true
LOCAL_MAINTENANCE=true
# Set a long random value before deployment. Local fallback is for development only.
SECRET_KEY=local-development-only-change-before-deployment-0123456789
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PUBLIC_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# test = local simulation with no real funds. disabled = payments unavailable.
# Production payouts are not implemented; do not use this app for real funds yet.
PAYMENT_MODE=test
COMMISSION_PERCENT=10

# Empty POSTGRES_HOST keeps the existing db.sqlite3.
# Set this only after explicit export/import of existing data (see README).
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=
# Local development may leave Redis empty; Compose uses redis://redis:6379/0.
REDIS_URL=

# Local console prints email confirmation links in the server terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@localhost

# Google Console OAuth web application. Authorized redirect URI:
# PUBLIC_URL/auth/google/callback/
# Enable YouTube Data API v3 and YouTube Analytics API for channel statistics.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Login Widget: configure your domain through BotFather /setdomain.
TELEGRAM_BOT_NAME=
TELEGRAM_BOT_TOKEN=

# Optional registry lookup. Without this only INN checksum is checked.
DADATA_API_TOKEN=
